{
  "compilerOptions": {
    "target": "es2018",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "../dist",
    "strict": false,
    "lib": ["es2018", "esnext.asynciterable"],
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*"],
  "exclude": ["node_modules", "**/*.test.ts"]
} 